# Server
PORT=4000

# Auth
JWT_SECRET=change_this_to_a_long_random_string

# Survey/task partner postback verification
# CPX Research / TheoremReach jaisi companies jab user ka task complete hone
# ka postback bhejein, tab woh yeh secret bhi bhejni chahiye taaki koi
# random insaan aapke wallet mein fake paisa na daal sake.
POSTBACK_SECRET=change_this_to_another_long_random_string

# Kitna % user ko milega (baaki platform ka commission)
# Jaise: 70 ka matlab user ko 70%, aapko 30% commission
USER_SHARE_PERCENT=70

# Minimum withdrawal amount (INR)
MIN_WITHDRAW=100
